{%- comment -%}
  Estimated Delivery Date block.

  The app-owned shop metafield $app.settings is the single configuration
  source. Without saved settings the block stays disabled. The JavaScript also
  requires a current provider-backed subscription response from the app's
  HMAC-authenticated Shopify app proxy before it reveals any estimate.

  The actual date math runs client-side in assets/delivery-date.js, which is a
  verbatim port of the app's tested app/lib/delivery-date.ts.
{%- endcomment -%}

{%- assign mf = shop.metafields["$app"].settings -%}

<div
  class="edd-block"
  data-edd
  data-edd-entitlement-url="/apps/supadatewise/entitlement"
  hidden
  style="color: {{ block.settings.text_color }}; font-size: {{ block.settings.font_size }}px;"
  {{ block.shopify_attributes }}
>
  <script type="application/json" data-edd-config>
    {%- if mf and mf.value -%}
      {{ mf.value | json }}
    {%- else -%}
      { "enabled": false }
    {%- endif -%}
  </script>

  <span data-edd-output aria-live="polite">{{ block.settings.loading_text }}</span>
</div>

{% schema %}
{
  "name": "Estimated Delivery Date",
  "target": "section",
  "javascript": "delivery-date.js",
  "settings": [
    {
      "type": "text",
      "id": "loading_text",
      "label": "Loading text",
      "default": "Calculating delivery date..."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#1a1a1a"
    },
    {
      "type": "number",
      "id": "font_size",
      "label": "Font size (px)",
      "default": 15
    }
  ]
}
{% endschema %}
