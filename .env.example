# Get a key at https://platform.claude.com
ANTHROPIC_API_KEY=sk-ant-...

# Optional: server-side free-scan metering (free tier at upstash.com).
# Without these, only the client-side scan gate applies.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Mobile builds only: the deployed backend the Capacitor shell calls.
# NEXT_PUBLIC_API_BASE_URL=https://your-deployment.vercel.app

# --- Billing (RevenueCat → Play Billing / StoreKit) ---
# Public SDK keys from RevenueCat → Project settings → API keys. These ship in
# the client bundle by design; the secret key never does.
NEXT_PUBLIC_REVENUECAT_ANDROID_KEY=
NEXT_PUBLIC_REVENUECAT_IOS_KEY=

# Shared secret you set in RevenueCat → Integrations → Webhooks as the
# Authorization header value. Without it /api/revenuecat refuses every request.
REVENUECAT_WEBHOOK_SECRET=
