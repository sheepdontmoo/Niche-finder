# Copy to .env and fill in. Every key is OPTIONAL — any source whose key is
# missing degrades to fixture/synthetic mode automatically, so the pipeline
# always runs end-to-end. Provide keys to get real data for that source.

# Ahrefs API (the only paid source; you already own it).
AHREFS_API_KEY=

# Anthropic / Claude — used for pain scoring, AIEO answer grading,
# and monetisation classification. Without it those steps fall back to
# deterministic heuristics.
ANTHROPIC_API_KEY=

# Reddit — OPTIONAL. The default Reddit client uses the no-key public JSON
# endpoints. Fill these in only to use the PRAW path (higher rate limits).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=niche-finder/0.1 (by u/yourname)

# Perplexity (or any search-grounded LLM) — OPTIONAL second AIEO grader.
PERPLEXITY_API_KEY=
